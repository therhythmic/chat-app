# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Public URL of the deployed app, e.g. https://chat-app.vercel.app
APP_URL=

# Messages via Twilio (optional until the number exists)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Workspace that texts to the number belong to
DEFAULT_WORKSPACE_ID=

# AI project tagging (optional)
ANTHROPIC_API_KEY=
